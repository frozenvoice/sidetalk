<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Sidetalk.App</RootNamespace>
    <AssemblyName>Sidetalk</AssemblyName>
    <ApplicationIcon>Assets\Sidetalk.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sidetalk.Core\Sidetalk.Core.csproj" />
    <Resource Include="Assets\Sidetalk.ico" />
  </ItemGroup>
</Project>
