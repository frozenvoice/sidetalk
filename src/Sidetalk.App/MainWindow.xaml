<Window x:Class="Sidetalk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SIDETALK · 사이드톡" Width="880" Height="740" MinWidth="740" MinHeight="640"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource InkBrush}"
        FontFamily="Segoe UI, Malgun Gothic" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <!-- THESIS: A compact transport console for the second conversation, not a diagnostic dashboard.
         OWN-WORLD: Charcoal shell, acid-lime play control, precise outlined controls and neutral type.
         STORY: Read the observed state, launch a second instance, inspect details only when needed.
         FIRST VIEWPORT: Wordmark and native tabs above one status surface; transport controls then two dependency rows.
         FORM: Portable cassette transport, grounded direction 4, seed acad4094; Operate, native Windows.
         FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md -->
    <Grid Margin="32,22,32,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="37" Height="37" Margin="0,0,12,0">
                        <Canvas Width="40" Height="40">
                            <Path Data="M 3,7 L 26,7 Q 30,7 30,11 L 30,23 Q 30,27 26,27 L 13,27 L 6,33 L 6,27 L 3,27 Q 0,27 0,23 L 0,11 Q 0,7 3,7 Z" Fill="{StaticResource AccentBrush}" />
                            <Path Data="M 33,14 L 37,14 Q 40,14 40,18 L 40,31 Q 40,34 37,34 L 35,34 L 35,39 L 28,34 L 18,34" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" Fill="Transparent" />
                            <Path Data="M 9,15 L 13,15 M 18,15 L 22,15" Stroke="{StaticResource CanvasBrush}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="SIDETALK" FontSize="29" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="본계정 옆에, 또 하나의 대화." Style="{StaticResource SecondaryText}" Margin="0,9,0,0" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="사이드톡" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
        </Grid>
        <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" KeyboardNavigation.TabNavigation="Local">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" Margin="0,22,0,0" />
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>
            <TabItem Header="보조 카카오톡" Style="{StaticResource TabHeader}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,6,0">
                    <StackPanel>
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="26,24,26,22">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="StatusTitleText" Text="상태 확인 중" FontSize="29" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,12,0" AutomationProperties.LiveSetting="Polite" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,9,0,0">
                                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource SecondaryBrush}" Margin="0,0,7,0" />
                                        <TextBlock x:Name="StatusBadgeText" Text="확인 중" FontSize="12" Foreground="{StaticResource SecondaryBrush}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="StatusDetailText" Text="필수 프로그램과 전용 환경을 확인하고 있습니다." Style="{StaticResource SecondaryText}" />
                                <TextBlock x:Name="PolicySummaryText" Text="" Visibility="Collapsed" Style="{StaticResource SecondaryText}" Margin="0,10,0,0" />
                                <WrapPanel Margin="0,26,0,0">
                                    <Button x:Name="LaunchButton" Style="{StaticResource PrimaryButton}" Click="LaunchButton_Click" MinWidth="260" MinHeight="54" Margin="0,0,12,8" IsEnabled="False"
                                            AutomationProperties.Name="보조 카카오톡 실행" ToolTip="전용 Sandboxie Plus 환경에서 공식 카카오톡을 실행합니다." ToolTipService.ShowOnDisabled="True">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M 0,0 L 0,14 L 11,7 Z" Width="11" Height="14" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <TextBlock Text="보조 카카오톡 실행" FontSize="15" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="StopButton" Content="보조 카카오톡 강제 종료" Style="{StaticResource ActionButton}" Click="StopButton_Click" MinHeight="54" Margin="0,0,0,8" IsEnabled="False"
                                            ToolTip="카카오톡 트레이의 종료를 먼저 사용하세요. 이 버튼은 전용 환경의 남은 프로세스까지 강제 종료합니다." ToolTipService.ShowOnDisabled="True" />
                                </WrapPanel>
                                <TextBlock Text="트레이 종료가 기본입니다. 위 종료 버튼은 전용 환경을 강제 종료합니다." Style="{StaticResource SecondaryText}" FontSize="12" LineHeight="18" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,12,0,24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="RefreshSummaryText" Text="4초마다 자동 확인" Style="{StaticResource SecondaryText}" FontSize="12" VerticalAlignment="Center" />
                            <Button x:Name="InspectButton" Grid.Column="1" Content="상태 새로 확인" Style="{StaticResource ActionButton}" Click="InspectButton_Click" Padding="14,8" MinHeight="36" />
                        </Grid>
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="공식 카카오톡" Style="{StaticResource BodyText}" Margin="0,0,12,12" />
                            <TextBlock x:Name="KakaoSummaryText" Grid.Column="1" Text="확인 중" Style="{StaticResource SecondaryText}" Margin="0,0,0,12" />
                            <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="Sandboxie Plus" Style="{StaticResource BodyText}" />
                                    <TextBlock x:Name="SandboxieSummaryText" Grid.Column="1" Text="확인 중" Style="{StaticResource SecondaryText}" />
                                </Grid>
                            </Border>
                        </Grid>
                        <TextBlock Text="처음 사용하는 PC라면 ‘초기 설정 · 진단’에서 전용 환경을 준비하세요." Style="{StaticResource SecondaryText}" FontSize="12" LineHeight="18" Margin="0,22,0,4" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="초기 설정 · 진단" Style="{StaticResource TabHeader}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="현재 환경" Style="{StaticResource SectionHeading}" />
                        <Border x:Name="RecoveryPanel" Background="{StaticResource SurfaceBrush}" CornerRadius="16" Padding="20,18,20,18" Margin="0,0,0,18" Visibility="Collapsed">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="복구 계획" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock x:Name="RecoveryStateText" Grid.Column="1" Text="확인 중" Style="{StaticResource SecondaryText}" FontSize="12" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock x:Name="RecoverySummaryText" Text="현재 설정을 확인하고 있습니다." Style="{StaticResource BodyText}" Margin="0,0,0,10" TextWrapping="Wrap" />
                                <TextBlock Text="변경 예정" Style="{StaticResource SectionHeading}" FontSize="15" Margin="0,0,0,4" />
                                <ItemsControl x:Name="RecoveryChangesList" AutomationProperties.Name="복구 변경 예정 항목" Margin="0,0,0,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource SecondaryText}" Margin="0,1" TextWrapping="Wrap" /></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="영향 범위" Style="{StaticResource SectionHeading}" FontSize="15" Margin="0,0,0,4" />
                                <ItemsControl x:Name="RecoveryAffectedList" AutomationProperties.Name="복구 영향 범위" Margin="0,0,0,6">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource SecondaryText}" Margin="0,1" TextWrapping="Wrap" /></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="RecoveryBlockerText" Text="" Style="{StaticResource SecondaryText}" Foreground="{StaticResource WarningInkBrush}" Margin="0,0,0,8" Visibility="Collapsed" TextWrapping="Wrap" />
                                <TextBlock x:Name="RecoveryProgressText" Text="" Style="{StaticResource SecondaryText}" Margin="0,0,0,8" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
                                <TextBlock x:Name="RecoveryScopeText" Text="자동 복구 허용 범위: WindowsRasMan · OnScreenKeyboard · WindowsLive · Edge_Fix · OfficeLicensing · OfficeClickToRun. 현재 사용자 설정 SbieCtrl_AutoRunSoftCompat=n과 같은 검증 범위에서 확인된 Sandboxie 관리 창 정리만 포함합니다. 관리 창이 확인되어 정리되면 저장하지 않은 관리 설정은 사라질 수 있습니다." Style="{StaticResource SecondaryText}" FontSize="12" LineHeight="17" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <CheckBox x:Name="AutomaticRecoveryCheckBox" Content="같은 검증 범위에서 다시 발생하면 자동 복구 허용" Foreground="{StaticResource InkBrush}" FontSize="14" IsChecked="False" Margin="0,0,0,10" ToolTip="여섯 템플릿, 현재 사용자 자동 검사 옵션, 같은 검증 조건에서 확인된 관리 창 정리만 포함합니다. 저장하지 않은 관리 설정은 사라질 수 있습니다." Checked="AutomaticRecoveryCheckBox_Changed" Unchecked="AutomaticRecoveryCheckBox_Changed" />
                                <WrapPanel>
                                    <Button x:Name="PrepareRecoveryButton" Content="복구하고 실행 준비" Style="{StaticResource PrimaryButton}" Click="PrepareRecoveryButton_Click" MinHeight="46" Margin="0,0,8,6" AutomationProperties.Name="복구하고 실행 준비" />
                                    <Button x:Name="RevokeAutomaticButton" Content="자동 복구 해제" Style="{StaticResource ActionButton}" Click="RevokeAutomaticButton_Click" MinHeight="46" Margin="0,0,8,6" />
                                    <Button x:Name="OpenRecoveryHistoryButton" Content="복구 내역 열기" Style="{StaticResource ActionButton}" Click="OpenRecoveryHistoryButton_Click" MinHeight="46" Margin="0,0,0,6" />
                                </WrapPanel>
                                <Expander IsExpanded="False" Margin="0,0,0,7">
                                    <Expander.Header>
                                        <TextBlock Text="보존되는 데이터" Style="{StaticResource SectionHeading}" FontSize="15" />
                                    </Expander.Header>
                                    <ItemsControl x:Name="RecoveryPreservedList" AutomationProperties.Name="복구 중 보존되는 데이터" Margin="0,7,0,4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource SecondaryText}" Margin="0,1" TextWrapping="Wrap" /></DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                                <TextBlock x:Name="RecoveryBackupText" Text="" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />
                                <TextBlock x:Name="RecoveryResultText" Text="" Style="{StaticResource SecondaryText}" Margin="0,5,0,0" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="PolicyDetailText" Text="환경을 확인하고 있습니다." Style="{StaticResource SecondaryText}" Margin="0,0,0,14" />
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="전용 환경" Style="{StaticResource SecondaryText}" Margin="0,4,12,4" />
                            <TextBlock x:Name="BoxNameText" Grid.Column="1" Text="확인 중" Style="{StaticResource BodyText}" Margin="0,4" />
                            <TextBlock Grid.Row="1" Text="저장 공간" Style="{StaticResource SecondaryText}" Margin="0,4,12,4" />
                            <TextBlock x:Name="StoragePathText" Grid.Row="1" Grid.Column="1" Text="확인 중" Style="{StaticResource BodyText}" Margin="0,4" />
                            <TextBlock Grid.Row="2" Text="프로세스" Style="{StaticResource SecondaryText}" Margin="0,4,12,4" />
                            <TextBlock x:Name="ProcessIdsText" Grid.Row="2" Grid.Column="1" Text="확인 중" Style="{StaticResource BodyText}" Margin="0,4" />
                            <TextBlock Grid.Row="3" Text="마지막 확인" Style="{StaticResource SecondaryText}" Margin="0,4,12,4" />
                            <TextBlock x:Name="CheckedAtText" Grid.Row="3" Grid.Column="1" Text="확인 중" Style="{StaticResource BodyText}" Margin="0,4" />
                        </Grid>
                        <ItemsControl x:Name="ChecksList" AutomationProperties.Name="상태 확인 항목" Margin="0,0,0,18">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource SecondaryText}" Margin="0,3" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button x:Name="ExportDiagnosticsButton" Content="진단 JSON 저장" Style="{StaticResource ActionButton}" Click="ExportDiagnosticsButton_Click" HorizontalAlignment="Left" />
                        <TextBlock Text="계정 인증 정보와 대화 내용은 수집하지 않습니다." Style="{StaticResource SecondaryText}" FontSize="12" LineHeight="18" Margin="0,8,0,26" />
                        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,0,0,24" />
                        <TextBlock Text="설치된 프로그램" Style="{StaticResource SectionHeading}" />
                        <TextBlock x:Name="KakaoAvailabilityText" Text="확인 중" Style="{StaticResource BodyText}" />
                        <TextBlock x:Name="KakaoInfoText" Text="설치 상태를 읽는 중" Style="{StaticResource SecondaryText}" Margin="0,4,0,14" />
                        <TextBlock x:Name="SandboxieAvailabilityText" Text="확인 중" Style="{StaticResource BodyText}" />
                        <TextBlock x:Name="SandboxieInfoText" Text="설치 상태를 읽는 중" Style="{StaticResource SecondaryText}" Margin="0,4,0,26" />
                        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,0,0,24" />
                        <TextBlock Text="처음 한 번만 준비하세요" Style="{StaticResource SectionHeading}" />
                        <TextBlock Text="1. 공식 카카오톡과 Sandboxie Plus를 설치합니다.&#10;2. 위의 변경 내용을 확인하고 ‘복구하고 실행 준비’를 누릅니다.&#10;3. 실행 준비가 되면 ‘보조 카카오톡 실행’을 누르고 공식 창에서 직접 로그인합니다." Style="{StaticResource SecondaryText}" Margin="0,0,0,16" />
                        <TextBlock Text="설정 변경은 표시된 범위를 승인한 뒤 진행합니다. 같은 문제의 자동 복구는 위 체크박스로 허용하거나 나중에 해제할 수 있습니다." Style="{StaticResource SecondaryText}" Margin="0,0,0,16" />
                        <WrapPanel Margin="0,0,0,22">
                            <Button Content="Sandboxie 공식 다운로드" Style="{StaticResource ActionButton}" Click="SandboxieDownloadButton_Click" Margin="0,0,8,8" />
                            <Button Content="카카오톡 공식 안내" Style="{StaticResource ActionButton}" Click="KakaoOfficialButton_Click" Margin="0,0,0,8" />
                        </WrapPanel>
                        <TextBlock Text="전용 환경의 소유 정보를 저장하고 선택한 폴더에 새 INI를 만듭니다. 기존 Sandboxie 설정을 이 파일로 덮어쓰지 마세요." Style="{StaticResource SecondaryText}" Margin="0,0,0,12" />
                        <Button x:Name="ExportSetupButton" Content="전용 INI 내보내기" Style="{StaticResource PrimaryButton}" Click="ExportSetupButton_Click" HorizontalAlignment="Left" />
                        <TextBlock x:Name="SetupResultText" Text="" Style="{StaticResource SecondaryText}" Margin="0,16,0,8" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <TextBlock Grid.Row="2" Text="로그인·송수신은 카카오톡에서 확인하세요. SIDETALK를 닫아도 카카오톡은 유지됩니다."
                   Style="{StaticResource SecondaryText}" FontSize="12" LineHeight="18" Margin="0,18,0,0" />
    </Grid>
</Window>
