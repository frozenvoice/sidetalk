<Window x:Class="Sidetalk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SIDETALK · 사이드톡"
        Width="900"
        Height="760"
        MinWidth="780"
        MinHeight="660"
        Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource InkBrush}"
        FontFamily="Malgun Gothic, Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid Margin="32,26,32,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="SIDETALK · 사이드톡" FontSize="28" FontWeight="SemiBold"
                       Foreground="{StaticResource InkBrush}" />
            <TextBlock Text="메인 카카오톡은 그대로 두고, 전용 Sandboxie Plus 공간에서 보조 계정을 실행합니다."
                       Style="{StaticResource SecondaryText}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                CornerRadius="6" Padding="0">
            <TabControl x:Name="MainTabs" BorderThickness="0" Background="Transparent"
                        Padding="20,0,20,16" KeyboardNavigation.TabNavigation="Local">
                <TabItem Header="보조 카카오톡" Style="{StaticResource TabHeader}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="4,18,4,4" Focusable="False">
                        <StackPanel>
                            <Border Background="#F8FAF8" BorderBrush="{StaticResource DividerBrush}"
                                    BorderThickness="1" CornerRadius="5" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="보조 환경 상태" Style="{StaticResource SecondaryText}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock x:Name="StatusTitleText" Text="상태 확인 중…"
                                                       FontSize="26" FontWeight="SemiBold"
                                                       Margin="0,5,12,5" />
                                            <TextBlock x:Name="StatusDetailText" Text="필수 프로그램과 전용 저장 공간을 확인하고 있습니다."
                                                       Style="{StaticResource SecondaryText}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{StaticResource SoftAccentBrush}"
                                                CornerRadius="12" Padding="12,6" VerticalAlignment="Top">
                                            <TextBlock x:Name="StatusBadgeText" Text="확인 중"
                                                       Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>

                                    <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,14,0,10" />
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="132" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="전용 상자" Style="{StaticResource SecondaryText}" Margin="0,3,12,3" />
                                        <TextBlock x:Name="BoxNameText" Grid.Row="0" Grid.Column="1" Text="확인 중…" Style="{StaticResource BodyText}" Margin="0,3" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="보조 저장 공간" Style="{StaticResource SecondaryText}" Margin="0,3,12,3" />
                                        <TextBlock x:Name="StoragePathText" Grid.Row="1" Grid.Column="1" Text="확인 중…" Style="{StaticResource BodyText}" Margin="0,3" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="상자 프로세스" Style="{StaticResource SecondaryText}" Margin="0,3,12,3" />
                                        <TextBlock x:Name="ProcessIdsText" Grid.Row="2" Grid.Column="1" Text="확인 중…" Style="{StaticResource BodyText}" Margin="0,3" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="마지막 확인" Style="{StaticResource SecondaryText}" Margin="0,3,12,3" />
                                        <TextBlock x:Name="CheckedAtText" Grid.Row="3" Grid.Column="1" Text="확인 중…" Style="{StaticResource BodyText}" Margin="0,3" />
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button x:Name="LaunchButton" Content="보조 카카오톡 실행"
                                                Style="{StaticResource PrimaryButton}" Click="LaunchButton_Click"
                                                IsEnabled="False" ToolTip="전용 Sandboxie Plus 상자에서 공식 카카오톡을 실행합니다." />
                                        <Button x:Name="StopButton" Content="보조 카카오톡 종료"
                                                Style="{StaticResource ActionButton}" Click="StopButton_Click"
                                                IsEnabled="False" ToolTip="SIDETALK 전용 상자 안의 프로세스만 종료합니다." />
                                        <Button x:Name="InspectButton" Content="상태 새로 확인"
                                                Style="{StaticResource ActionButton}" Click="InspectButton_Click"
                                                ToolTip="필수 프로그램과 전용 상자의 상태를 다시 확인합니다." />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="필수 프로그램" Style="{StaticResource SectionHeading}" />
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}"
                                    BorderThickness="1" CornerRadius="5" Padding="16" Margin="0,0,0,22">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="1" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="공식 카카오톡" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,2,12,2" />
                                    <TextBlock x:Name="KakaoAvailabilityText" Grid.Row="0" Grid.Column="1" Text="확인 중" Style="{StaticResource SecondaryText}" Margin="0,2,18,2" />
                                    <TextBlock x:Name="KakaoInfoText" Grid.Row="0" Grid.Column="2" Text="설치 상태를 읽는 중…" Style="{StaticResource SecondaryText}" Margin="0,2" />
                                    <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{StaticResource DividerBrush}" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Sandboxie Plus" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,12,12,2" />
                                    <TextBlock x:Name="SandboxieAvailabilityText" Grid.Row="2" Grid.Column="1" Text="확인 중" Style="{StaticResource SecondaryText}" Margin="0,12,18,2" />
                                    <TextBlock x:Name="SandboxieInfoText" Grid.Row="2" Grid.Column="2" Text="설치 상태를 읽는 중…" Style="{StaticResource SecondaryText}" Margin="0,12,0,2" />
                                </Grid>
                            </Border>

                            <TextBlock Text="확인 항목" Style="{StaticResource SectionHeading}" />
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}"
                                    BorderThickness="1" CornerRadius="5" Padding="16" Margin="0,0,0,6">
                                <ItemsControl x:Name="ChecksList" AutomationProperties.Name="상태 확인 항목">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="·" Foreground="{StaticResource AccentBrush}" FontSize="18"
                                                           VerticalAlignment="Top" />
                                                <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource SecondaryText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="초기 설정 · 진단" Style="{StaticResource TabHeader}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="4,18,4,4" Focusable="False">
                        <StackPanel>
                            <TextBlock Text="초기 설정" Style="{StaticResource SectionHeading}" />
                            <TextBlock Text="SIDETALK는 설치나 시스템 설정을 자동으로 바꾸지 않습니다. 아래 작업을 사용자가 직접 완료한 뒤, 설정 안내 파일로 확인할 내용을 남길 수 있습니다."
                                       Style="{StaticResource SecondaryText}" Margin="0,0,0,16" />

                            <Border Background="{StaticResource WarningBrush}" BorderBrush="#ECD9A7"
                                    BorderThickness="1" CornerRadius="5" Padding="16" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="설정 순서" Style="{StaticResource BodyText}" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="1" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="Sandboxie Plus를 공식 사이트에서 설치합니다. 설치 파일 실행과 시스템 변경은 사용자가 확인한 뒤 진행하세요." Style="{StaticResource BodyText}" />
                                    </Grid>
                                    <Grid Margin="0,8,0,3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="2" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="아래에서 전용 INI를 내보낸 뒤 검토하세요. Sandboxie Plus의 INI 편집기에서 기존 내용을 유지하고 새 섹션만 추가합니다." Style="{StaticResource BodyText}" />
                                    </Grid>
                                    <Grid Margin="0,8,0,3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="3" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="새로고침 후 데이터 분리 검증을 먼저 진행하세요. 통과한 뒤 보조 카카오톡에서 사용자가 직접 로그인·기기 인증합니다." Style="{StaticResource BodyText}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                                <Button Content="Sandboxie Plus 공식 다운로드 열기" Style="{StaticResource ActionButton}"
                                        Click="SandboxieDownloadButton_Click" />
                                <Button Content="카카오톡 공식 안내 열기" Style="{StaticResource ActionButton}"
                                        Click="KakaoOfficialButton_Click" />
                            </StackPanel>

                            <TextBlock Text="검토 파일" Style="{StaticResource SectionHeading}" />
                            <Border Background="#F8FAF8" BorderBrush="{StaticResource DividerBrush}"
                                    BorderThickness="1" CornerRadius="5" Padding="16" Margin="0,0,0,22">
                                <StackPanel>
                                    <TextBlock Text="전용 설정 파일 내보내기" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                    <TextBlock Text="전용 환경의 이름과 소유 정보를 SIDETALK 폴더에 저장하고, 선택한 폴더에 INI 파일을 만듭니다. Sandboxie 설정 적용은 별도 확인이 필요합니다."
                                               Style="{StaticResource SecondaryText}" Margin="0,5,0,12" />
                                    <Button x:Name="ExportSetupButton" Content="전용 INI 내보내기"
                                            Style="{StaticResource PrimaryButton}" Click="ExportSetupButton_Click"
                                            HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="진단" Style="{StaticResource SectionHeading}" />
                            <Border Background="#F8FAF8" BorderBrush="{StaticResource DividerBrush}"
                                    BorderThickness="1" CornerRadius="5" Padding="16" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="진단 JSON 저장" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                    <TextBlock Text="현재 상태, 버전, 경로 확인 결과를 점검용 JSON으로 저장합니다. 계정 인증 정보나 대화 내용은 수집하지 않습니다."
                                               Style="{StaticResource SecondaryText}" Margin="0,5,0,12" />
                                    <Button x:Name="ExportDiagnosticsButton" Content="진단 JSON 저장"
                                            Style="{StaticResource ActionButton}" Click="ExportDiagnosticsButton_Click"
                                            HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="SetupResultText" Text="" Style="{StaticResource SecondaryText}"
                                       Margin="0,12,0,8" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <TextBlock Grid.Row="2" Text="프로세스가 실행 중이어도 로그인 성공을 의미하지 않습니다. 로그인·기기 인증과 두 계정의 송수신·알림은 공식 카카오톡 창에서 직접 확인하세요."
                   Style="{StaticResource SecondaryText}" FontSize="12" Margin="2,14,2,0" />
    </Grid>
</Window>
